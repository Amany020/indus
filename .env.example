# ─── IndustryMind Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Create a Supabase project at https://supabase.com
# Enable pgvector: SQL Editor → CREATE EXTENSION IF NOT EXISTS vector;
# Create a Storage bucket named "industrymind" (private)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_KEY=your-supabase-service-key-here
SUPABASE_BUCKET=industrymind

# ─── Google AI (Gemini + Embeddings) ─────────────────────────────────────────
# Get API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Auto-detected at startup; override if needed:
GEMINI_MODEL=gemini-3.8-flash
# Optional separate model for page image analysis; defaults to GEMINI_MODEL:
GEMINI_VISION_MODEL=
# Embedding model for multilingual retrieval:
EMBED_MODEL=gemini-embedding-2-preview
EMBED_DIM=768

# ─── Retrieval Thresholds (tuned by eval/run.py) ────────────────────────────
MIN_SIM=0.35
HIGH_SIM=0.60

# ─── Demo Resilience ────────────────────────────────────────────────────────
# Set true only for scripted demos; always labelled in UI and logs
DEMO_CACHE=false

# ─── Frontend (set in frontend/.env.local) ───────────────────────────────────
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# NEXT_PUBLIC_MOCK=false

# ─── Feature Flags (all DEFAULT OFF) ─────────────────────────────────────────
# R2: Authentication mode — "none" (default, no auth) | "supabase" | "header"
AUTH_MODE=supabase
# R3: Multi-factory tenancy
TENANCY_ENFORCED=false
RLS_ENABLED=false
# R4: Retention jobs
RETENTION_JOBS_ENABLED=false
RETENTION_QUERY_DAYS=365
RETENTION_DRAFT_DAYS=30
RETENTION_AUDIO_DAYS=7
# R5: QR scanning
QR_SCAN_ENABLED=false
# R6: TTS provider — "browser" (default, client-side) | "bhashini"
TTS_PROVIDER=browser
BHASHINI_API_KEY=
# R7: SOP change proposals
SOP_PROPOSALS_ENABLED=false
# R8: Knowledge graph
KNOWLEDGE_GRAPH_ENABLED=false
# R9: Change-impact engine
CHANGE_IMPACT_ENABLED=false
# R10: Multi-agent evidence review
MULTI_AGENT_REVIEW=false
